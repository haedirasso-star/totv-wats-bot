# ══════════════════════════════════════════════════════════════
#  TOTV+ WhatsApp Bot — ملف البيئة
#  ضعه في جذر مجلد البوت بجانب package.json
#
#  ⚠️  لا ترفع هذا الملف إلى GitHub — هو مُدرج في .gitignore
#  ⚠️  المفاتيح أدناه أُرسلت في محادثة، فهي مكشوفة.
#      غيّرها ثم استبدل القيم هنا فقط — لا يتغيّر أي كود.
# ══════════════════════════════════════════════════════════════

PORT=3000


# ── 1) Gemini — الذكاء الاصطناعي ──────────────────────────────
#  من: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6IFbobQGDH46JZgs77IcXovGOjQqi3mJuODy9GsStuL7A
GEMINI_MODEL=gemini-2.0-flash


# ── 2) WhatsApp Cloud API ─────────────────────────────────────
#  ❗ ناقص — لم ترسله بعد. البوت لن يستقبل ولا يرسل أي رسالة بدونه.
#
#  من: developers.facebook.com → تطبيقك → WhatsApp → API Setup
#    • Temporary access token  → WA_TOKEN     (يعمل 24 ساعة فقط)
#    • Phone number ID         → WA_PHONE_ID
#
#  للإنتاج: أنشئ System User Token دائماً من Business Settings
WA_TOKEN=
WA_PHONE_ID=

#  رمز تتحقق به Meta من رابطك — اكتب نفسه في لوحة Meta
WA_VERIFY_TOKEN=totv_webhook_2026


# ── 3) Telegram — تحويل الطلبات وأزرار الموافقة ───────────────
TG_BOT_TOKEN=5902809892:AAFm-HAJpU5-bJVpfPcEpow6UUkGopHvIQI
TG_ADMIN_CHAT=5154917874


# ── 4) Supabase — إصدار أكواد التفعيل ─────────────────────────
SUPABASE_URL=https://hlmaksidfqdarwunedqj.supabase.co

#  ❗ ناقص — يجب أن يكون مفتاح Secret لا Publishable.
#     Supabase → Settings → API Keys → قسم "Secret keys" → Copy
#     يبدأ بـ  sb_secret_...
#
#  هذا هو المكان الوحيد المسموح فيه بالمفتاح السرّي، لأنه سيرفر
#  خلفي مغلق. لا تضعه في التطبيق ولا في صفحة الأدمن أبداً.
SUPABASE_SERVICE_KEY=


# ── 5) معلومات الأعمال ────────────────────────────────────────
SUPPORT_WHATSAPP=9647714415816
TELEGRAM_CHANNEL=https://t.me/O_2828
DOWNLOAD_URL=https://totv.app/download.html


# ══════════════════════════════════════════════════════════════
